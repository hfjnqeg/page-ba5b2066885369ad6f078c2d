nt-size:clamp(40px,7vw,74px);line-height:1;letter-spacing:-0.04em}\n  .hero-head h1 em{font-style:normal;background:var(--accent);padding:0 8px 6px}\n  .hero-kicker{font-size:13px;letter-spacing:0.22em;text-transform:uppercase;color:var(--grey);margin:0 0 10px}\n  .hero-tail{max-width:330px;font-size:14px;color:var(--ink-soft);margin:0}\n  .dash{display:grid;grid-template-columns:repeat(12,1fr);gap:14px;margin-top:24px}\n  .tile{border:2px solid var(--ink);background:var(--white);padding:18px 18px 16px;display:flex;flex-direction:column;gap:6px;min-height:126px}\n  .tile .label{font-size:11px;letter-spacing:0.2em;color:var(--grey);text-transform:uppercase}\n  .tile .figure{font-size:clamp(26px,3.4vw,40px);font-weight:700;line-height:1.05;letter-spacing:-0.03em}\n  .tile .figure small{font-size:14px;font-weight:400;letter-spacing:0;color:var(--ink-soft);margin-left:4px}\n  .tile .memo{font-size:13px;color:var(--ink-soft);margin:0;line-height:1.55}\n  .tile-accent{background:var(--accent);border-color:var(--ink)}\n  .tile-accent .label{color:#3c4a13}\n  .tile-dark{background:var(--ink);color:#fff;border-color:var(--ink)}\n  .tile-dark .label{color:#9fa3a9}\n  .tile-dark .memo{color:#c9cbd0}\n  .tile-dark .figure small{color:#c9cbd0}\n  .t-wide{grid-column:span 5}\n  .t-mid{grid-column:span 3}\n  .t-thin{grid-column:span 4}\n\n  /* 区块通用 */\n  section{padding:56px 0 8px}\n  .sec-head{border-bottom:2px solid var(--ink);padding-bottom:14px;margin-bottom:30px;display:flex;flex-wrap:wrap;align-items:baseline;gap:14px}\n  .sec-head h2{font-size:clamp(24px,3.2vw,34px);letter-spacing:-0.03em}\n  .sec-head .num{font-size:12px;letter-spacing:0.2em;color:var(--grey);border:1px solid var(--line);padding:2px 8px}\n  .sec-head .sub{margin:0;font-size:14px;color:var(--ink-soft);flex:1 1 260px}\n\n  /* 粗描边直角卡片 */\n  .card{border:2px solid var(--ink);background:var(--white);padding:24px}\n  .card h3{font-size:18px;margin-bottom:10px}\n  .card p:last-child{margin-bottom:0}\n\n  .about-g