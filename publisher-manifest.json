--accent-deep)}\n\n  .stack{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}\n  .stack .plan{grid-column:auto}\n\n  /* 客户端 */\n  .clients{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n  .client h3{font-size:16px;letter-spacing:0.02em;margin-bottom:8px}\n  .client p{font-size:14px;color:var(--ink-soft);margin:0}\n  .client .tag{display:inline-block;font-size:11px;letter-spacing:0.14em;border:1px solid var(--ink);padding:2px 7px;margin-bottom:12px;color:var(--ink-soft)}\n\n  /* 使用说明 */\n  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;counter-reset:step}\n  .step{border:2px solid var(--ink);background:var(--white);padding:20px 18px;counter-increment:step}\n  .step::before{content:\"0\" counter(step);display:block;font-size:26px;font-weight:700;letter-spacing:-0.03em;color:var(--grey);margin-bottom:10px}\n  .step h3{font-size:15px;margin-bottom:6px}\n  .step p{font-size:13.5px;color:var(--ink-soft);margin:0}\n\n  /* FAQ 对话气泡 */\n  .faq-group{margin-bottom:34px}\n  .faq-group h3{font-size:13px;letter-spacing:0.2em;color:var(--grey);text-transform:uppercase;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--line)}\n  .qa{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:14px;margin-bottom:14px;align-items:start}\n  .q{border:2px solid var(--ink);background:var(--white);padding:14px 16px;font-weight:700;font-size:15px;line-height:1.55;position:relative}\n  .q::after{content:\"\";position:absolute;right:-9px;top:20px;width:16px;height:16px;background:var(--white);border-right:2px solid var(--ink);border-top:2px solid var(--ink);transform:rotate(45deg)}\n  .a{background:var(--ink);color:#e8e9ea;padding:14px 18px;font-size:14.5px;line-height:1.7}\n  .a b{color:var(--accent)}\n  .a p{margin:0 0 8px}\n  .a p:last-child{margin:0}\n\n  footer{margin-top:56px;border-top:2px solid var(--ink);padding-top:22px;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;font-size:13px;color:var(--ink-soft)}\n  footer b{letter-spacing:0.1em;color:var(--ink)}\n\n  @media (max-width:980px){\n    .layout{grid-template-columns:1fr}\n    .side{position:static;height:auto;flex-direction:row;flex-wrap:wrap;align-items:center;gap:14px;padding:16px 20px;border-right:0;border-bottom:1px solid var(--line)}\n    .side-brand{font-size:16px;padding:8px 12px;letter-spacing:0.1em}\n    .side-brand span{display:none}\n    .side-nav{flex-direction:row;flex-wrap:wrap;gap:0;font-size:13px}\n    .side-nav a{padding:6px 10px;border-left:0;border-bottom:2px solid transparent}\n    .side-nav a:hover,.side-nav a:focus-visible{border-left:0;border-bottom-color:var(--ink)}\n    .side-note{display:none}\n    .wrap{padding:0 20px}\n    .hero{padding:32px 0 16px}\n    .about-grid,.plans,.stack{grid-template-columns:1fr}\n    .clients{grid-template-columns:1fr}\n    .steps{grid-template-columns:1fr 1fr}\n    .qa{grid-template-columns:1fr;gap:8px}\n    .q::after{right:auto;left:20px;top:auto;bottom:-9px;border-right:0;border-top:0;border-left:2px solid var(--ink);border-bottom:2px solid var(--ink)}\n    .t-wide,.t-mid,.t-thin{grid-column:span 12}\n    .plan.pick{box-shadow:6px 6px 0 var(--accent)}\n  }\n  @media (max-width:520px){\n    .steps{grid-template-columns:1fr}\n    .hero-head h1{font-size:clamp(34px,11vw,50px)}\n  }\n</style><div class=\"layout\">\n\n  <aside class=\"side\">\n    <a class=\"side-brand\" href=\"#top\">苦瓜云<span>KUGUA CLOUD</span></a>\n    <nav class=\"side-nav\" aria-label=\"页面目录\">\n      <a href=\"#intro\">先聊两句</a>\n      <a href=\"#plans\">套餐对照</a>\n      <a href=\"#how\">怎么开始用</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n    <div class=\"side-note\">\n      页面上所有价格与流量都是<b>订阅说明口径</b>，最终以下单页展示为准。慢慢看，不着急。\n    </div>\n  </aside>\n\n  <main id=\"top\">\n    <div class=\"wrap\">\n\n      <header class=\"hero\">\n        <div class=\"hero-head\">\n          <div>\n            <p class=\"hero-kicker\">订阅说明 / 第 2299 版</p>\n            <h1>苦瓜云，<br><em>摆明白</em>再下单</h1>\n          </div>\n          <p class=\"hero-tail\">\n            不讲玄乎的形容词，只把档位、流量、设备数和价格摊开给你看。看得懂，再决定要不要。\n          </p>\n        </div>\n\n        <div class=\"dash\">\n          <div class=\"tile t-wide tile-dark\">\n            <span class=\"label\">在售档位</span>\n            <span class=\"figure\">3 <small>档订阅</small></span>\n            <p class=\"memo\">基础版、旗舰版、团队版。没有隐藏的第四档，也没有要你打电话才肯说的价格。</p>\n          </div>\n          <div class=\"tile t-mid tile-accent\">\n            <span class=\"label\">月付起步</span>\n            <span class=\"figure\">¥15 <small>/ 月起</small></span>\n            <p class=\"memo\">年付按 10 个月计价。</p>\n          </div>\n          <div class=\"tile t-mid\">\n            <span class=\"label\">流量区间</span>\n            <span class=\"figure\">100–1000 <small>GB / 月</small></span>\n            <p class=\"memo\">按档递增。</p>\n          </div>\n          <div class=\"tile t-thin\">\n            <span class=\"label\">设备上限</span>\n            <span class=\"figure\">3 / 5 / 20 <small>台</small></span>\n            <p class=\"memo\">同时在线数量，按档位区分。</p>\n          </div>\n          <div class=\"tile t-thin tile-dark\">\n            <span class=\"label\">服务时段</span>\n            <span class=\"figure\">工单 <small>优先响应</small></span>\n            <p class=\"memo\">旗舰版及以上为优先队列。</p>\n          </div>\n          <div class=\"tile t-thin\">\n            <span class=\"label\">客户端</span>\n            <span class=\"figure\">3 <small>类平台</small></span>\n            <p class=\"memo\">桌面、移动、路由各自有对应说明。</p>\n          </div>\n        </div>\n      </header>\n\n      <section id=\"intro\">\n        <div class=\"sec-head\">\n          <span class=\"num\">01</span>\n          <h2>先聊两句</h2>\n          <p class=\"sub\">如果你只想知道这页面是干嘛的，这里说清楚。</p>\n        </div>\n\n        <div class=\"about-grid\">\n          <div class=\"card\">\n            <h3>苦瓜云把订阅这件事写得比较啰嗦</h3>\n            <p>我们相信大多数人不想在购买前读一长串豪言壮语。你想知道的其实就几件事：多少钱、给多少、能挂几台、用哪个客户端、卡住了找谁。</p>\n            <p>所以这一页按这个顺序排下来。<strong>每一档都逐条列权益</strong>，没有“更多权益详见”这种话；每个客户端都写清楚它的用途边界，不承诺它做不到的事。</p>\n            <p>如果你看完还有疑问，去页面底部的问答区。那里的答案是按真实被问到的问题整理的，不是营销话术的变体。</p>\n          </div>\n          <div class=\"card\">\n            <h3>三件小事，先说在前面</h3>\n            <ul class=\"plain-list\">\n              <li><b>价格是订阅口径</b>，年付按 10 个月计，具体金额以下单页为准。</li>\n              <li><b>流量按月结算</b>，当月未用完的部分不结转到下月。</li>\n              <li><b>设备数指同时在线</b>，退出登录即释放名额，不是注册绑定数量。</li>\n              <li><b>客户端不做内置分发</b>，本页只说明用途与配置思路。</li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"plans\">\n        <div class=\"sec-head\">\n          <span class=\"num\">02</span>\n          <h2>套餐对照</h2>\n          <p class=\"sub\">左边两档、右边一档，逐项对齐看，比来回翻页省事。</p>\n        </div>\n\n        <div class=\"plans\">\n          <article class=\"plan\">\n            <div class=\"plan-top\">\n              <p class=\"plan-name\">基础版</p>\n              <p class=\"plan-price\">¥15 <small>/ 月</small></p>\n              <p class=\"plan-note\">按年付仅需 ¥150 / 年</p>\n            </div>\n            <div class=\"plan-body\">\n              <ul>\n                <li>每月 100GB 流量</li>\n                <li>支持 3 台设备同时在线</li>\n                <li>基础流媒体解锁</li>\n                <li>普通线路节点池</li>\n              </ul>\n            </div>\n          </article>\n\n          <article class=\"plan pick\">\n            <div class=\"plan-top\">\n              <span class=\"badge\">多数人的选择</span>\n              <p class=\"plan-name\">旗舰版</p>\n              <p class=\"plan-price\">¥35 <small>/ 月</small></p>\n              <p class=\"plan-note\">按年付仅需 ¥350 / 年</p>\n            </div>\n            <div class=\"plan-body\">\n              <ul>\n                <li>每月 300GB 流量</li>\n                <li>支持 5 台设备同时在线</li>\n                <li>全节点原生流媒体解锁</li>\n                <li>IPLC 专线游戏加速优化</li>\n                <li>7×24 优先工单支持</li>\n              </ul>\n            </div>\n          </article>\n        </div>\n\n        <div class=\"stack\">\n          <article class=\"plan\">\n            <div class=\"plan-top\">\n              <p class=\"plan-name\">团队版</p>\n              <p class=\"plan-price\">¥85 <small>/ 月</small></p>\n              <p class=\"plan-note\">按年付仅需 ¥850 / 年</p>\n            </div>\n            <div class=\"plan-body\">\n              <ul>\n                <li>每月 1000GB 流量</li>\n                <li>支持 20 台设备同时在线</li>\n                <li>VIP 专属高带宽节点</li>\n                <li>支持企业定制路由</li>\n                <li>专属客户经理服务</li>\n              </ul>\n            </div>\n          </article>\n          <div class=\"card\">\n            <h3>怎么挑，给个笨办法</h3>\n            <p>先算你一个月大概用多少 GB，再数一数家里/办公室要同时挂几台。两个数字都对得上最低那档，就选基础版，别为用不上的额度多付钱。</p>\n            <p>如果经常在外面看流媒体，或者对线路稳定性敏感，旗舰版是分界线：多出来的部分是线路池和解锁范围，不是单纯的流量加法。</p>\n            <p>团队版的差别在于管理侧——20 台设备和定制路由，是为多人协作准备的，一个人用属于浪费。</p>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"how\">\n        <div class=\"sec-head\">\n          <span class=\"num\">03</span>\n          <h2>怎么开始用</h2>\n          <p class=\"sub\">四步，从下单到第一次连上，中间不需要猜。</p>\n        </div>\n\n        <div class=\"steps\">\n          <div class=\"step\">\n            <h3>选档下单</h3>\n            <p>对照上面的权益表挑一档，月付或年付都行。年付省的是两个月，不是折扣券。</p>\n          </div>\n          <div class=\"step\">\n            <h3>确认设备名额</h3>\n            <p>先数清楚要同时在线几台。超出的部分不会自动升级，只会被挤掉。</p>\n          </div>\n          <div class=\"step\">\n            <h3>挑客户端</h3>\n            <p>看下一节，按你的系统选一类。同一账号在不同设备上用同一个客户端类型即可。</p>\n          </div>\n          <div class=\"step\">\n            <h3>配置并试连</h3>\n            <p>第一次连上后先简单测一下能不能开常规网页，再按需切换线路。</p>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"clients\">\n        <div class=\"sec-head\">\n          <span class=\"num\">04</span>\n          <h2>客户端</h2>\n          <p class=\"sub\">只说明用途和配置思路，本页不提供安装包下载地址。</p>\n        </div>\n\n        <div class=\"clients\">\n          <article class=\"card client\">\n            <span class=\"tag\">桌面端</span>\n            <h3>Windows / macOS</h3>\n            <p>适合固定工位长期在线。装好后按订阅信息填入配置，桌面端一般会常驻托盘或菜单栏，方便随时切换线路。多设备名额里，一台电脑算一台。</p>\n          </article>\n          <article class=\"card client\">\n            <span class=\"tag\">移动端</span>\n            <h3>iOS / Android</h3>\n            <p>手机和平板各算一台设备。移动端更适合临时使用，长时间挂着会额外耗电。iOS 上通常需要通过系统级配置导入，具体以客户端说明为准。</p>\n          </article>\n          <article class=\"card client\">\n            <span class=\"tag\">路由与扩展</span>\n            <h3>路由器 / 浏览器扩展</h3>\n            <p>路由器方式能让整个局域网共用一份配置，适合家里设备多的情况；浏览器扩展只作用于浏览器流量，不接管系统其他应用。两者都计入设备名额。</p>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"faq\">\n        <div class=\"sec-head\">\n          <span class=\"num\">05</span>\n          <h2>常见问题</h2>\n          <p class=\"sub\">按被问到的频率分组。有答案，不敷衍。</p>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于套餐与价格</h3>\n\n          <div class=\"qa\">\n            <div class=\"q\">年付真的比月付便宜吗？便宜多少？</div>\n            <div class=\"a\">\n              <p>是的。年付按 <b>10 个月</b>计价：基础版 ¥150 / 年、旗舰版 ¥350 / 年、团队版 ¥850 / 年，相当于两个月不收费。</p>\n              <p>没有额外的折扣码，也不用凑单。年付一次付清，中途不按比例退。</p>\n            </div>\n          </div>\n\n          <div class=\"qa\">\n            <div class=\"q\">我这个月流量没用完，能留到下个月吗？</div>\n            <div class=\"a\">\n              <p>不能。流量按自然月结算，<b>当月未用完的部分不结转</b>。所以选档的时候别一味往大了挑，按实际用量来更划算。</p>\n            </div>\n          </div>\n\n          <div class=\"qa\">\n            <div class=\"q\">中途想换档位，怎么处理？</div>\n            <div class=\"a\">\n              <p>可以升档，也可以降档，但档位变更从<b>下一个计费周期</b>生效，当前周期内的流量和设备上限不随之变动。</p>\n              <p>如果只是想临时多挂一台设备，不建议为此升档，退出另一台设备的登录更快。</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于设备与使用</h3>\n\n          <div class=\"qa\">\n            <div class=\"q\">设备数是怎么算的？换手机要重新占名额吗？</div>\n            <div class=\"a\">\n              <p>算的是<b>同时在线</b>的数量，不是注册绑定。旧设备退出登录后，名额立刻释放，新设备可以直接用。</p>\n              <p>所以换手机不用额外付费，也不需要联系客服解绑。</p>\n            </div>\n          </div>\n\n          <div class=\"qa\">\n            <div class=\"q\">三个档位在流媒体上的区别具体在哪？</div>\n            <div class=\"a\">\n              <p>基础版是<b>基础流媒体解锁</b>；旗舰版和团队版是全节点原生解锁，覆盖的平台范围更宽。团队版在此之上提供 VIP 专属高带宽节点。</p>\n              <p>具体某个平台能不能看，取决于该平台当下的策略，这里不做逐个平台的保证。</p>\n            </div>\n          </div>\n\n          <div class=\"qa\">\n            <div class=\"q\">我用路由器方式，会占用好几台设备名额吗？</div>\n            <div class=\"a\">\n              <p>会占，但通常只按<b>一份配置</b>计。路由器后面的手机、电脑共用这一份，不会逐台叠加。</p>\n              <p>具体以你所用客户端在设备侧的识别方式为准，如果出现异常占用，可通过工单反馈。</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于支持与变更</h3>\n\n          <div class=\"qa\">\n            <div class=\"q\">出问题找谁？不同档位的支持有差别吗？</div>\n            <div class=\"a\">\n              <p>统一走工单。旗舰版提供 <b>7×24 优先工单支持</b>，团队版另有专属客户经理。基础版同样可以提单，只是排在普通队列。</p>\n              <p>提单时把客户端类型、系统版本和现象写清楚，处理会快不少。</p>\n            </div>\n          </div>\n\n          <div class=\"qa\">\n            <div class=\"q\">团队版的“企业定制路由”需要额外谈吗？</div>\n            <div class=\"a\">\n              <p>属于团队版权益范围内，由专属客户经理对接具体需求。能定制到什么程度要看你的网络结构，本页不预先承诺方案细节。</p>\n            </div>\n          </div>\n\n          <div class=\"qa\">\n            <div class=\"q\">本页上的信息一定准确吗？</div>\n            <div class=\"a\">\n              <p>本页是订阅说明页，价格和权益按当前口径整理。如果与下单页出现不一致，<b>以下单页为准</b>。</p>\n              <p>我们不在这页提供安装包或外部下载链接，需要客户端请按你已获得的官方渠道获取。</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <footer>\n        <span><b>苦瓜云</b> · 订阅说明页</span>\n        <span>价格与权益以下单页展示为准 · 本页不提供下载地址</span>\n      </footer>\n\n    </div>\n  </main>\n</div>",
